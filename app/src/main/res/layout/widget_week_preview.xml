<?xml version="1.0" encoding="utf-8"?>
<!-- 整周网格小组件的静态选择器预览（API 31+ previewLayout 使用），纯 XML 无运行时数据。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <RelativeLayout
        android:id="@+id/widget_week_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_week_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/widget_status_background"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_status_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="第 1 周" />

        <TextView
            android:id="@+id/widget_week_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/widget_week_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="9月1日 · 示例课表" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/widget_week_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_week_header"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <TextView style="@style/WidgetWeekDayLabel" android:textColor="@color/widget_accent" android:text="一" />
        <TextView style="@style/WidgetWeekDayLabel" android:text="二" />
        <TextView style="@style/WidgetWeekDayLabel" android:text="三" />
        <TextView style="@style/WidgetWeekDayLabel" android:text="四" />
        <TextView style="@style/WidgetWeekDayLabel" android:text="五" />
        <TextView style="@style/WidgetWeekDayLabel" android:text="六" />
        <TextView style="@style/WidgetWeekDayLabel" android:text="日" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_week_weekdays"
        android:layout_marginTop="3dp"
        android:orientation="vertical">
    <LinearLayout style="@style/WidgetWeekRow">
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="高等数学"
        android:background="#E3F0FB" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="大学英语"
        android:background="#E2F6E9" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="操作系统"
        android:background="#FDF2D2" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetWeekRow">
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="高等数学"
        android:background="#E3F0FB" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="大学英语"
        android:background="#E2F6E9" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="操作系统"
        android:background="#FDF2D2" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetWeekRow">
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="移动应用开发实践"
        android:background="#DCF3F0" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetWeekRow">
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="移动应用开发实践"
        android:background="#DCF3F0" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetWeekRow">
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="马克思主义基本原理"
        android:background="#FBEEDF" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="体育"
        android:background="#FCE7EA" />
    </LinearLayout>
    <LinearLayout style="@style/WidgetWeekRow">
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="马克思主义基本原理"
        android:background="#FBEEDF" />
        <TextView style="@style/WidgetWeekPreviewCell"
        android:text="体育"
        android:background="#FCE7EA" />
    </LinearLayout>
    </LinearLayout>
</RelativeLayout>
