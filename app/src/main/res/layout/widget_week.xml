<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <RelativeLayout
        android:id="@+id/widget_week_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_week_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/widget_status_background"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_status_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="第 1 周" />

        <TextView
            android:id="@+id/widget_week_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/widget_week_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="8月30日 · 课表名" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/widget_week_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_week_header"
        android:layout_marginTop="6dp"
        android:background="@color/widget_divider" />

    <FrameLayout
        android:id="@+id/widget_week_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_week_divider"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/widget_week_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/widget_week_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            tools:text="本周无课\n点击打开应用" />
    </FrameLayout>
</RelativeLayout>
