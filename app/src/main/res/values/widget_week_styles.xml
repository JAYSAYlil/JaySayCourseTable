<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 整周网格小组件静态预览（widget_week_preview.xml）专用样式 -->
    <style name="WidgetWeekPreviewDayHeader">
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetWeekPreviewCell">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
